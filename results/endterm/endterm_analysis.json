  "alert_rules": [
    {
      "alert": "InstanceDown",
      "severity": "critical",
      "detects": "crashed or hung service instance",
      "threshold": "scrape fails for 4 s",
      "response": "gateway stops routing to it (automatic); restart policy or watchdog restarts it; on call checks docker logs if it is not back within 60 s"
    },
    {
      "alert": "InstanceRestarted",
      "severity": "warning",
      "detects": "a process that crashed and was restarted (self-healed, so InstanceDown may not fire)",
      "threshold": "process start time changed within 30 s",
      "response": "no action if it happens once; find the cause in the logs if it repeats (crash loop)"
    },
    {
      "alert": "ReplicaUnready",
      "severity": "warning",
      "detects": "a replica failing its readiness check (dead, hung or cut off from the database)",
      "threshold": "2 failed health checks, DOWN for 3 s",
      "response": "traffic goes to the other replica (automatic); check /health/ready of the instance"
    },
    {
      "alert": "BackendUnavailable",
      "severity": "critical",
      "detects": "user-visible outage of one service",
      "threshold": "0 healthy replicas for 3 s",
      "response": "page on call; check the database and both replicas; fail over or restart"
    },
    {
      "alert": "HighErrorRate",
      "severity": "critical",
      "detects": "server errors seen by clients (dependency or database failure, overload)",
      "threshold": "5xx share above 5% for 4 s (at least 1 request per second)",
      "response": "check dependency and breaker panels; page on call if it lasts more than 30 s"
    },
    {
      "alert": "HighLatencyP95",
      "severity": "warning",
      "detects": "slow dependency, saturation or retries piling up",
      "threshold": "p95 above 1 s (the latency SLO) for 6 s",
      "response": "check dependency latency and in-flight requests; load shedding protects the service meanwhile"
    },
    {
      "alert": "CircuitBreakerOpen",
      "severity": "warning",
      "detects": "a dependency that keeps failing",
      "threshold": "5 consecutive failures opened the breaker",
      "response": "callers degrade (cached data, pending verification) automatically; investigate the dependency"
    },
    {
      "alert": "NoPrimaryDatabase",
      "severity": "critical",
      "detects": "database failure or failover in progress",
      "threshold": "no primary for 3 s",
      "response": "Patroni promotes the standby (about 25 s); services answer 503 or serve cached data meanwhile; check etcd quorum if it takes longer than 60 s"
    },
    {
      "alert": "LoadShedding",
      "severity": "warning",
      "detects": "traffic above the capacity of the instances",
      "threshold": "more than 1 shed request per second for 4 s",
      "response": "scale out or throttle clients; shed requests get a fast 503 with Retry-After"
    },
    {
      "alert": "AuthFailureBurst",
      "severity": "critical",
      "detects": "credential stuffing, token forgery or probing of the data of other users",
      "threshold": "more than 2 denials per second for 4 s",
      "response": "audit log shows actor and resource; block the source at the gateway and rotate keys if tokens were forged"
    },
    {
      "alert": "RateLimitAbuse",
      "severity": "warning",
      "detects": "a client flooding the API or guessing passwords",
      "threshold": "more than 1 throttled request per second for 4 s",
      "response": "throttling is automatic; check the audit log for the offending principal and block it if it persists"
    }
  ]
}
